{
  "name": "slack-response-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Slack Bolt app that sends messages with response buttons via an HTTP API and posts clicks back to a callback URL",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
