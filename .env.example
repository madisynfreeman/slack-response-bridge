# Bot token: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token for Socket Mode: Basic Information -> App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=xapp-your-app-token

# Callers of POST /api/messages must send this in the x-api-key header
API_KEY=change-me

# Default URL that button clicks are POSTed to (a request can override it with callbackUrl)
CALLBACK_URL=https://example.com/slack-responses

# Port for the HTTP API (/api/messages, /health)
PORT=3000
